# Copy this file to `api/.env` and fill real values.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5241

ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=NP.click_DB;User Id=sa;Password=ChangeThisStrongPassword!;TrustServerCertificate=True;Encrypt=False

JWT__Issuer=http://localhost:5241
JWT__Audience=http://localhost:5241
JWT__SigninKey=ReplaceWithAVeryLongRandomSigningKeyAtLeast64Chars

EmailSettings__SmtpServer=smtp.gmail.com
EmailSettings__Port=587
EmailSettings__EnableSsl=true
EmailSettings__Username=your-email@example.com
EmailSettings__Password=app-password-here
EmailSettings__FromEmail=your-email@example.com

Cloudinary__CloudName=your-cloudinary-cloud-name
Cloudinary__ApiKey=your-cloudinary-api-key
Cloudinary__ApiSecret=your-cloudinary-api-secret

Frontend__BaseUrl=http://localhost:3000
